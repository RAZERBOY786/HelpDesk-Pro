APP_NAME=HelpDesk Pro
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite is convenient for local development. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://helpdesk:change_me@localhost:5432/helpdesk_db
DATABASE_URL=sqlite:///./helpdesk.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173

UPLOAD_DIR=./private_uploads
MAX_UPLOAD_SIZE_MB=5

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=support@example.test

# First administrator created by the seed script.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe123!